FROM nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PORT=8080 \
    HWM_OUTPUT_ROOT=/tmp/hunyuan-world-mirror \
    HF_HOME=/models/huggingface \
    TORCH_HOME=/models/torch \
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    ffmpeg \
    git \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    python3.10 \
    python3-pip \
    python3.10-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements_gcp.txt requirements_gcp.txt
RUN python3.10 -m pip install --upgrade pip setuptools wheel \
    && python3.10 -m pip install torch==2.4.0 torchvision==0.19.0 --index-url https://download.pytorch.org/whl/cu124 \
    && python3.10 -m pip install -r requirements_gcp.txt \
    && python3.10 -m pip install gsplat --index-url https://docs.gsplat.studio/whl/pt24cu124

COPY . .

EXPOSE 8080

CMD ["python3.10", "gcp_basic_ui.py"]
