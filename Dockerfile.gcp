FROM python:3.10-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PORT=8080 \
    HWM_OUTPUT_ROOT=/tmp/hunyuan-world-mirror \
    HF_HOME=/models/huggingface \
    TORCH_HOME=/models/torch \
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

RUN set -eux; \
    for attempt in 1 2 3 4 5; do \
        rm -rf /var/lib/apt/lists/*; \
        if apt-get update -o Acquire::Retries=5 && apt-get install -y --no-install-recommends \
            build-essential \
            cmake \
            ffmpeg \
            git \
            libgl1 \
            libglib2.0-0 \
            libgomp1; then \
            rm -rf /var/lib/apt/lists/*; \
            exit 0; \
        fi; \
        sleep "$((attempt * 20))"; \
    done; \
    exit 1

WORKDIR /app

COPY requirements.txt requirements_gcp.txt ./
RUN python -m pip install --upgrade pip setuptools wheel \
    && python -m pip install torch==2.4.0 torchvision==0.19.0 --index-url https://download.pytorch.org/whl/cu124 \
    && python -m pip install -r requirements_gcp.txt \
    && python -m pip install gsplat --index-url https://docs.gsplat.studio/whl/pt24cu124

COPY . .

EXPOSE 8080

CMD ["python", "gcp_basic_ui.py"]
